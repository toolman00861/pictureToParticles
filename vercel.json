{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix particle-effect install",
  "buildCommand": "npm --prefix particle-effect run build",
  "outputDirectory": "particle-effect/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
